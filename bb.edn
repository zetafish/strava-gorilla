{:paths ["src"]
 :deps {org.babashka/http-client {:mvn/version "0.4.22"}
        com.cnuernber/charred {:mvn/version "1.038"}
        dev.weavejester/medley {:mvn/version "1.10.0"}}
 :pods {org.babashka/postgresql {:version "0.1.6"}}
 :tasks
 {:requires ([strava.cli :as cli])

  server {:doc "Wake up the Gorilla"
          :task (clojure "-M" "-m" "strava-gorilla.core")}

  search {:doc "Search activities"
          :requires [strava.cli.search]
          :task (strava.cli.search/run *command-line-args*)}

  monthly {:requires [strava.cli.monthly]
           :task (strava.cli.monthly/run *command-line-args*)}

  weekly  {:requires [strava.cli.monthly]
           :task (strava.cli.monthly/run-weekly *command-line-args*)}

  calendar {:requires [strava.cli.calendar]
            :task (strava.cli.calendar/run *command-line-args*)}

  eff {:requires [strava.cli.eff]
       :task (strava.cli.eff/run *command-line-args*)}

  heatmap {:requires [strava.cli.heatmap]
           :task (strava.cli.heatmap/run *command-line-args*)}

  line {:requires [strava.cli.line]
        :task (strava.cli.line/run *command-line-args*)}

  v:load {:requires [strava.cli.load]
          :task (strava.cli.load/run *command-line-args*)}

  scatter {:requires [strava.cli.scatter]
           :task (strava.cli.scatter/run *command-line-args*)}

  stats {:requires [strava.cli.stats]
         :task (strava.cli.stats/run *command-line-args*)}

  sync {:requires [strava.cli.sync]
        :task (strava.cli.sync/run *command-line-args*)}

