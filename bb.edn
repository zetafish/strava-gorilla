{:paths ["src"]
 :deps {org.babashka/http-client {:mvn/version "0.4.22"}
        dev.weavejester/medley {:mvn/version "1.10.0"}}
 :tasks
 {:requires ([strava.cli :as cli])
  eff {:doc "Compute efficiency factor"
       :task (cli/eff *command-line-args*)}
  scatter {:doc "Compute scatter plots"
           :task (cli/scatter *command-line-args*)}
  trend {:doc "Perform trend analysis"
         :task (cli/trend *command-line-args*)}
  histogram {:doc "Plot histogram of metric"
             :task (cli/histogram *command-line-args*)}
  line {:doc "Plot line chart of metric over time"
        :task (cli/line *command-line-args*)}
  heatmap {:doc "Plot heatmap of metric1 vs metric2"
           :task (cli/heatmap *command-line-args*)}
  sync {:doc "Sync data from strava"
        :task (cli/sync *command-line-args*)}
  tag {:doc "Manage activity tags"
       :task (cli/tag *command-line-args*)}
  search {:doc "Search for activities"
          :task (cli/search *command-line-args*)}
  details {:doc "Print activity details"
           :task (cli/details *command-line-args*)}
  fetch-desc {:doc "Fetch activity details"
              :task (cli/fetch-desc *command-line-args*)}
  refresh-token {:doc "Refresh Strava OAuth token"
                 :task (cli/refresh-token *command-line-args*)}
  clerk {:doc "Start Clerk notebook"
         :task (shell "clj -X:clerk")}}}
