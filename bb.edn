 :pods {org.babashka/postgresql {:version "0.1.6"}}
 :tasks
 {:requires ([strava.cli :as cli])

  server {:doc "Wake up the Gorilla"
          :task (clojure "-M" "-m" "strava-gorilla.core")}

  search {:doc "Search activities by name, tag, date, distance, or HR"
          :requires [strava.cli.search]
          :task (strava.cli.search/run *command-line-args*)}

  analyze {:doc "Analyze an activity"
           :requires [strava.cli.analyze]
           :task (apply strava.cli.analyze/-main *command-line-args*)}

  monthly {:doc "Monthly totals: distance, time, avg HR/speed/cadence"
           :requires [strava.cli.monthly]
           :task (strava.cli.monthly/run *command-line-args*)}

  weekly  {:doc "Weekly totals: distance, time, avg HR/speed/cadence"
           :requires [strava.cli.monthly]
           :task (strava.cli.monthly/run-weekly *command-line-args*)}

  #_#_calendar {:doc "ASCII calendar view of runs for a month/year"
            :requires [strava.cli.calendar]
            :task (strava.cli.calendar/run *command-line-args*)}

  #_#_eff {:doc "Efficiency factor (speed/HR) per quarter of an activity"
       :requires [strava.cli.eff]
       :task (strava.cli.eff/run *command-line-args*)}

  #_#_heatmap {:doc "Render HR-vs-pace heatmap from a single activity's FIT"
           :requires [strava.cli.heatmap]
           :task (strava.cli.heatmap/run *command-line-args*)}

  #_#_line {:doc "Line chart of a metric over time within an activity"
        :requires [strava.cli.line]
        :task (strava.cli.line/run *command-line-args*)}

  #_#_v:load {:doc "Training load: ATL / CTL / TSB rolling averages"
          :requires [strava.cli.load]
          :task (strava.cli.load/run *command-line-args*)}

  #_#_scatter {:doc "Scatter plot of two metrics across activities"
           :requires [strava.cli.scatter]
           :task (strava.cli.scatter/run *command-line-args*)}

  #_#_stats {:doc "Summary stats (distance, pace, HR, EF) for one activity"
         :requires [strava.cli.stats]
         :task (strava.cli.stats/run *command-line-args*)}

  sync {:doc "Scrape Strava calendar + download FITs for -y YEAR [-m MONTH]"
        :requires [strava.cli.sync]
        :task (strava.cli.sync/run *command-line-args*)}

